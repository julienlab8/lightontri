# Types de fichiers modernes
AddType image/avif .avif
AddType image/webp .webp
AddType font/woff2 .woff2
AddType text/markdown .md
AddDefaultCharset UTF-8
AddCharset UTF-8 .md .txt

# Page d'erreur LIGHT ON
ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

# Fichiers internes du dépôt : jamais servis
<FilesMatch "^(CLAUDE|README)\.md$">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^/tools/

# Cache : les pages doivent toujours être revérifiées auprès du serveur.
# Sans cette règle, les navigateurs gardent les pages HTML en cache "au jugé"
# et peuvent afficher une ancienne version (c'est ce qui masquait les classements).
# Avec "no-cache", le navigateur revérifie à chaque visite : réponse 304 très
# légère si rien n'a changé, sinon il récupère la nouvelle page. Personne ne
# reste bloqué sur une vieille version. Les fichiers statiques (CSS/JS/images)
# ne sont pas concernés : ils sont déjà versionnés par "?v=".
<IfModule mod_headers.c>
  <FilesMatch "\.(html|md|txt|xml)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # L'index de recherche est régénéré avec le contenu : il doit être revérifié
  # à chaque fois (304 léger si rien n'a changé) pour ne pas servir un index
  # périmé après l'ajout d'une page ou d'un texte. Une version par langue
  # (search-index.json, search-index-en.json, search-index-de.json).
  <FilesMatch "^search-index(-(en|de))?\.json$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Versions Markdown des pages (llms.txt v2) : la page HTML reste l'adresse officielle pour les moteurs
<IfModule mod_headers.c>
  <Files "index.md">
    Header set Link "<https://www.lightontri.com/>; rel=canonical"
  </Files>
  <Files "woippy.md">
    Header set Link "<https://www.lightontri.com/woippy.html>; rel=canonical"
  </Files>
  <Files "woippy-evenement.md">
    Header set Link "<https://www.lightontri.com/woippy-evenement.html>; rel=canonical"
  </Files>
  <Files "pierre-percee.md">
    Header set Link "<https://www.lightontri.com/pierre-percee.html>; rel=canonical"
  </Files>
  <Files "pierre-percee-evenement.md">
    Header set Link "<https://www.lightontri.com/pierre-percee-evenement.html>; rel=canonical"
  </Files>
  <Files "madine.md">
    Header set Link "<https://www.lightontri.com/madine.html>; rel=canonical"
  </Files>
  <Files "madine-evenement.md">
    Header set Link "<https://www.lightontri.com/madine-evenement.html>; rel=canonical"
  </Files>
  <Files "premier-triathlon.md">
    Header set Link "<https://www.lightontri.com/premier-triathlon.html>; rel=canonical"
  </Files>
  <Files "communaute.md">
    Header set Link "<https://www.lightontri.com/communaute.html>; rel=canonical"
  </Files>
  <Files "reglement.md">
    Header set Link "<https://www.lightontri.com/reglement.html>; rel=canonical"
  </Files>
  <Files "resultats.md">
    Header set Link "<https://www.lightontri.com/resultats.html>; rel=canonical"
  </Files>
</IfModule>

# Une seule adresse officielle : https://www.lightontri.com/
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP_HOST} ^lightontri\.com$ [NC]
RewriteRule ^(.*)$ https://www.lightontri.com/$1 [R=301,L]
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ https://www.lightontri.com/ [R=301,L]
</IfModule>

# Refonte du 11/10/2026 : anciennes pages du dépôt -> nouvelle arborescence
Redirect 301 /courses.html https://www.lightontri.com/
Redirect 301 /infos.html https://www.lightontri.com/premier-triathlon.html
Redirect 301 /actualites.html https://www.lightontri.com/
Redirect 301 /evenement-woippy.html https://www.lightontri.com/woippy-evenement.html
Redirect 301 /evenement-pierre-percee.html https://www.lightontri.com/pierre-percee-evenement.html
Redirect 301 /evenement-madine.html https://www.lightontri.com/madine-evenement.html

# Bascule depuis l'ancien site Wix (plan du site relevé le 11/10/2026)
<IfModule mod_rewrite.c>
RewriteEngine On
# Pages des 3 lieux et leurs copies
RewriteRule ^light-on-triathlon-woippy/?$ https://www.lightontri.com/woippy.html [R=301,L,NC]
RewriteRule ^light-on-triathlon-pierre-perc(e|%C3%A9|é)e/?$ https://www.lightontri.com/pierre-percee.html [R=301,L,NC]
RewriteRule ^copie-de-light-on-tri-pierre-perc.*$ https://www.lightontri.com/pierre-percee.html [R=301,L,NC]
RewriteRule ^light-on-triathlon-madine/?$ https://www.lightontri.com/madine.html [R=301,L,NC]
RewriteRule ^copie-de-light-on-tri-madine(-1)?/?$ https://www.lightontri.com/madine.html [R=301,L,NC]
# Espaces participants : futur guide participant, sur la page « L'événement » de chaque lieu
RewriteRule ^participants-woippy/?$ https://www.lightontri.com/woippy-evenement.html#guide [R=301,NE,L,NC]
RewriteRule ^participants-pierre-percee/?$ https://www.lightontri.com/pierre-percee-evenement.html#guide [R=301,NE,L,NC]
RewriteRule ^participants-madine/?$ https://www.lightontri.com/madine-evenement.html#guide [R=301,NE,L,NC]
# Inscriptions, conseils, triathlon, FAQ
RewriteRule ^inscriptions-light-on-tri/?$ https://www.lightontri.com/#inscriptions [R=301,NE,L,NC]
RewriteRule ^nos-conseils/?$ https://www.lightontri.com/premier-triathlon.html [R=301,L,NC]
RewriteRule ^triathlon/?$ https://www.lightontri.com/premier-triathlon.html [R=301,L,NC]
RewriteRule ^faq/?$ https://www.lightontri.com/woippy-evenement.html#faq [R=301,NE,L,NC]
# Résultats, médias, presse, bénévoles
RewriteRule ^r.+sultats-photos/?$ https://www.lightontri.com/resultats.html [R=301,L,NC]
RewriteRule ^m.+dias-presse/?$ https://www.lightontri.com/communaute.html#presse [R=301,NE,L,NC]
RewriteRule ^presse/?$ https://www.lightontri.com/communaute.html#presse [R=301,NE,L,NC]
RewriteRule ^(devenir-benevoles|benevoles-light-on-tri)/?$ https://www.lightontri.com/communaute.html#benevole [R=301,NE,L,NC]
# Boutique Wix arrêtée : vers l'accueil
RewriteRule ^(product-page|category)(/.*)?$ https://www.lightontri.com/ [R=301,L,NC]
# Anciens événements qui n'existent plus (Seignosse, Favières, pages /events/) : supprimés définitivement
RewriteRule ^light-on-triathlon-(seignosse|favieres)/?$ - [G,L,NC]
RewriteRule ^devenir-benevoles-seignosse/?$ - [G,L,NC]
RewriteRule ^events(/.*)?$ - [G,L,NC]
</IfModule>
